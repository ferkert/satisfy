{% extends "base.html.twig" %}

{% block title %}Import from composer.lock{% endblock %}

{% block lead %}
    <p class="page-lead">Adds the source repository of every package in the lock file, including dev packages.</p>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'form-panel'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.file, {label: 'composer.lock file'}) }}

        <div class="form-actions">
            <button class="btn btn-solid theme-primary" type="submit">Import repositories</button>
            <a href="{{ path('repository') }}" class="btn btn-text theme-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
