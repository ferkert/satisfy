{% extends "base.html.twig" %}

{% block title %}Delete repository{% endblock %}

{% block lead %}
    <p class="page-lead">Its packages disappear from the package index with the next build.</p>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'form-panel'}}) }}
        <p class="delete-target font-monospace">{{ repository.url }}</p>

        {{ form_errors(form) }}
        {{ form_widget(form) }}

        <div class="form-actions">
            <button class="btn btn-solid theme-danger" type="submit" name="delete_form[submit]">Delete repository</button>
            <a href="{{ path('repository') }}" class="btn btn-text theme-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
