{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block page_header %}{% endblock %}

{% block content %}
    <div class="login">
        <h1>Sign in</h1>
        <p class="page-lead">Sign in to manage this package repository.</p>

        <form action="{{ path('login') }}" method="post" class="form-panel">
            {% if error %}
                <div class="alert theme-danger" role="alert">{{ error.messageKey }}</div>
            {% endif %}
            <div class="mb-3">
                <label class="form-label" for="username">Username</label>
                <input type="text" id="username" name="_username" value="{{ username }}" class="form-control" autocomplete="username" required autofocus>
            </div>
            <div class="mb-3">
                <label class="form-label" for="password">Password</label>
                <input type="password" id="password" name="_password" class="form-control" autocomplete="current-password" required>
            </div>
            <button class="btn btn-solid theme-primary w-100" type="submit">Sign in</button>
        </form>
    </div>
{% endblock %}
