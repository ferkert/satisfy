{% extends "base.html.twig" %}
{% from '_icons.html.twig' import icon %}

{% block title %}Repositories{% endblock %}

{% block lead %}
    <p class="page-lead">Satis reads packages from these repositories and publishes them as one Composer repository.</p>
{% endblock %}

{% block actions %}
    <a href="{{ path('repository_upload') }}" class="btn btn-outline theme-secondary">
        {{ icon('upload') }} Import composer.lock
    </a>
    <a href="{{ path('repository_new') }}" class="btn btn-solid theme-primary">
        {{ icon('plus-lg') }} Add repository
    </a>
{% endblock %}

{% block content %}
    <section class="snippet" aria-labelledby="snippet-title">
        <div class="snippet-header">
            <div>
                <h2 class="section-title" id="snippet-title">Install packages from this server</h2>
                <p class="section-text">Add this to the <span class="font-monospace">composer.json</span> of a project.</p>
            </div>
            <button type="button" class="btn btn-sm btn-outline theme-secondary" data-copy="#composer-snippet" hidden>
                {{ icon('clipboard') }} <span data-copy-label aria-live="polite">Copy</span>
            </button>
        </div>
        <pre class="snippet-code"><code id="composer-snippet">{{ config|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</code></pre>
    </section>

    <section aria-labelledby="repositories-title">
        <h2 class="section-title" id="repositories-title">
            Sources <span class="badge badge-subtle theme-secondary">{{ repositories|length }}</span>
        </h2>

        {% if repositories is empty %}
            <div class="empty-state">
                <p class="empty-state-title">No repositories yet</p>
                <p class="section-text">Add a repository by its URL, or import all repositories from a composer.lock file.</p>
            </div>
        {% else %}
            <ul class="list-group repo-list">
                {% for repository in repositories %}
                    <li class="list-group-item">
                        <a class="repo-link" href="{{ path('repository_edit', {repository: repository.id}) }}">
                            <span class="badge badge-subtle theme-primary font-monospace">{{ repository.type }}</span>
                            <span class="repo-url font-monospace">{{ repository.url }}</span>
                            <span class="repo-source font-monospace" title="Installation source">{{ repository.installationSource }}</span>
                            {{ icon('chevron-right') }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endblock %}
