{% extends "base.html.twig" %}

{% set repository = form.vars.value %}

{% block title %}Edit repository{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'form-panel'}}) }}
        {% include 'views/_form.html.twig' %}

        <div class="form-actions">
            <button class="btn btn-solid theme-primary" type="submit">Save changes</button>
            <a href="{{ path('repository') }}" class="btn btn-text theme-secondary">Cancel</a>
            <a href="{{ path('repository_delete', {repository: repository.id}) }}" class="btn btn-outline theme-danger ms-auto">Delete repository</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
