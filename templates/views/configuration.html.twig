{% extends "base.html.twig" %}

{% block title %}Configuration{% endblock %}

{% block lead %}
    <p class="page-lead">Settings for <span class="font-monospace">satis.json</span>. Changes apply with the next build.</p>
{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {class: 'form-panel form-panel-wide'}}) }}
        {{ form_errors(form) }}

        <fieldset class="form-section">
            <legend class="section-title">Repository</legend>
            {{ form_row(form.name, {help: 'Vendor and name, for example acme/packages.'}) }}
            {{ form_row(form.description) }}
            {{ form_row(form.homepage, {help: 'Public URL of this package repository.'}) }}
        </fieldset>

        <fieldset class="form-section">
            <legend class="section-title">Package selection</legend>
            {{ form_row(form.requireAll) }}
            {{ form_row(form.requireDependencies) }}
            {{ form_row(form.requireDevDependencies) }}
            {{ form_row(form.requireDependencyFilter) }}
            {{ form_row(form.require) }}
            {{ form_row(form.blacklist) }}
            {{ form_row(form.abandoned) }}
        </fieldset>

        <fieldset class="form-section">
            <legend class="section-title">Stability</legend>
            {{ form_row(form.minimumStability) }}
            {{ form_row(form.minimumStabilityPerPackage) }}
        </fieldset>

        <fieldset class="form-section">
            <legend class="section-title">Output</legend>
            {{ form_row(form.outputDir) }}
            {{ form_row(form.outputHtml) }}
            {{ form_row(form.prettyPrint) }}
            {{ form_row(form.providers) }}
            {{ form_row(form.includeFilename) }}
            {{ form_row(form.twigTemplate) }}
            {{ form_row(form.notifyBatch) }}
        </fieldset>

        <fieldset class="form-section">
            <legend class="section-title">Advanced</legend>
            {{ form_row(form.config) }}
            {{ form_rest(form) }}
        </fieldset>

        <div class="form-actions form-actions-sticky">
            <button class="btn btn-solid theme-primary" type="submit">Save configuration</button>
            <a href="{{ path('repository') }}" class="btn btn-text theme-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
