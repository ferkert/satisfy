{%- from '_icons.html.twig' import icon -%}
{%- set route = app.request ? app.request.attributes.get('_route', '') : '' -%}
{%- set alert_themes = {success: 'success', info: 'info', notice: 'info', warning: 'warning', error: 'danger', danger: 'danger'} -%}
{%- set alert_icons = {success: 'check-circle-fill', info: 'info-circle-fill', warning: 'exclamation-triangle-fill', danger: 'x-circle-fill'} -%}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Satisfy{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="32x32">
    <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
    <script src="{{ asset('js/app.js') }}" defer></script>
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main">Skip to content</a>

    <header class="app-header">
        <div class="container app-header-inner">
            <a class="app-brand" href="{{ path('repository') }}">
                {{ icon('box-seam') }}
                <span>Satisfy</span>
            </a>
            {% if satis.name %}
                <span class="app-repo-name font-monospace">{{ satis.name }}</span>
            {% endif %}

            <nav class="app-nav" aria-label="Main">
                <ul class="nav nav-underline">
                    {% for item in [
                        {label: 'Repositories', route: 'repository', active: route starts with 'repository'},
                        {label: 'Configuration', route: 'configuration', active: route == 'configuration'},
                        {label: 'Build', route: 'satis_build', active: route starts with 'satis_build'},
                    ] %}
                        <li class="nav-item">
                            <a class="nav-link{{ item.active ? ' active' }}" href="{{ path(item.route) }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            <div class="app-header-end">
                <a class="btn btn-sm btn-text theme-secondary" href="{{ path('index') }}">
                    Package page {{ icon('box-arrow-up-right') }}
                </a>
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <a class="btn btn-sm btn-text theme-secondary" href="{{ path('_logout_main') }}">
                        {{ icon('box-arrow-right') }} Log out
                    </a>
                {% endif %}
            </div>
        </div>
    </header>

    <main class="container app-main" id="main">
        {% for type, messages in app.flashes %}
            {% set theme = alert_themes[type] ?? 'info' %}
            {% for message in messages %}
                <div class="alert theme-{{ theme }}" role="{{ theme in ['warning', 'danger'] ? 'alert' : 'status' }}">
                    {{ icon(alert_icons[theme]) }}
                    <div>{{ message }}</div>
                    <button type="button" class="btn-close ms-auto" data-dismiss="alert" aria-label="Dismiss"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block page_header %}
            <div class="page-header">
                <div class="page-heading">
                    <h1>{% block heading %}{{ block('title') }}{% endblock %}</h1>
                    {% block lead %}{% endblock %}
                </div>
                <div class="page-actions">{% block actions %}{% endblock %}</div>
            </div>
        {% endblock %}

        {% block content %}{% endblock %}
    </main>
</body>
</html>
